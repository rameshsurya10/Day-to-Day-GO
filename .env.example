# ── Day to Day — environment variables ──────────────────────────────
# Local: copy to .env.local and fill in. Vercel: add the same keys in
# Project → Settings → Environment Variables. Never commit real values.
# Restart `npm run dev` after changing any value.

# REQUIRED — the password you log in with. Use 12+ characters on a live site.
APP_PASSWORD=

# REQUIRED — signs the login cookie. At least 32 characters.
# Generate:  openssl rand -hex 32
AUTH_SECRET=

# OPTIONAL — AI coach ("Buddy"). Without a key the chat is disabled.
# Groq key (starts with gsk_): https://console.groq.com/keys
GROQ_API_KEY=
# Any OpenAI-compatible endpoint works; this is Groq's.
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Model id — current list: https://console.groq.com/docs/models
COACH_MODEL=openai/gpt-oss-120b

# OPTIONAL — tuning (defaults shown)
# SESSION_DAYS=30            # how long a login lasts
# LOGIN_MAX_ATTEMPTS=5       # wrong passwords per IP …
# LOGIN_WINDOW_MINUTES=15    # … per this many minutes
# COACH_MAX_REQUESTS=30      # coach messages per IP per 10 minutes
